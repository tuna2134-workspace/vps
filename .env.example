# Copy to .env and fill in real values. Never commit secrets.

# --- Common ---
ENV=development
DEBUG=false

# --- Control Plane HTTP API ---
HTTP_LISTEN_ADDRESS=:8080
# Public base URL used when building console websocket URLs
PUBLIC_BASE_URL=http://localhost:8080

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vps?sslmode=disable

# --- Sessions / Auth ---
SESSION_TTL=24h
SESSION_TOKEN_LEN=32
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW=15m

# --- Argon2id ---
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- gRPC: Control Plane -> Agent ---
# (the Control Plane dials agents; the agent also listens on its own port)
GRPC_LISTEN_ADDRESS=:9000
GRPC_CLIENT_TIMEOUT=60s

# --- mTLS (Control Plane side) ---
TLS_ENABLED=false
TLS_CERT_FILE=dev/certs/cp.crt
TLS_KEY_FILE=dev/certs/cp.key
TLS_CA_FILE=dev/certs/ca.crt
TLS_SERVER_NAME=agent.internal

# --- Node health ---
NODE_DEGRADED_AFTER=30s
NODE_OFFLINE_AFTER=60s

# --- Console ---
CONSOLE_TOKEN_TTL=2m

# ============================================================
# Agent configuration
# ============================================================

# Agent identity reported in heartbeats (must match the registered node name)
AGENT_ID=agent-1
# gRPC listen address for the AgentService
AGENT_GRPC_LISTEN_ADDRESS=:9001
# Local libvirt connection
LIBVIRT_URI=qemu:///system
# Default libvirt storage pool for VM disks
AGENT_STORAGE_POOL=default
# Directory for transient files (images, cloud-init ISOs)
AGENT_WORK_DIR=/var/lib/vps-agent

# --- mTLS (Agent side) ---
AGENT_TLS_ENABLED=false
AGENT_TLS_CERT_FILE=dev/certs/agent.crt
AGENT_TLS_KEY_FILE=dev/certs/agent.key
AGENT_TLS_CA_FILE=dev/certs/ca.crt